# --- Spotify ---------------------------------------------------------------
# Crea una app en https://developer.spotify.com/dashboard
# Redirect URI (debe coincidir EXACTAMENTE con la del dashboard):
#   http://127.0.0.1:8000/api/auth/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback

# --- Modelo de lenguaje ------------------------------------------------------
# Es lo que perfila tu biblioteca. Elige proveedor:
#
#   anthropic   Claude. El mejor resultado. Necesita saldo en console.anthropic.com
#   openai      GPT. Necesita saldo en platform.openai.com
#   ollama      Modelo local. GRATIS, sin clave y sin conexion: instala Ollama,
#               ejecuta `ollama pull llama3.1` y dejalo corriendo
#   lmstudio    Modelo local con LM Studio, mismo caso
#   openrouter  Pasarela a casi cualquier modelo
#   groq        Muy rapido y barato
#
AI_PROVIDER=anthropic

# Vacio = el modelo por defecto del proveedor elegido.
AI_MODEL=

# La clave del proveedor. Con ollama o lmstudio dejala vacia.
AI_API_KEY=

# Solo si usas un servidor propio o un proveedor no listado arriba.
# Ejemplo para Ollama en otra maquina: http://192.168.1.50:11434/v1
AI_BASE_URL=

# --- Last.fm (opcional pero muy recomendable) -------------------------------
# Tags de comunidad que se le pasan al etiquetador como contexto. Sin esto, en
# catalogo nicho o reciente el modelo no reconoce el tema y su perfil acaba
# siendo el prior del genero. Key gratuita en www.last.fm/api/account/create
LASTFM_API_KEY=

# --- App -------------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8000
DB_PATH=data/library.db
