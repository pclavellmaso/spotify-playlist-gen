# --- Spotify ---------------------------------------------------------------
# Crea una app en https://developer.spotify.com/dashboard
# Redirect URI (debe coincidir EXACTAMENTE con la del dashboard):
#   http://127.0.0.1:8000/api/auth/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback

# --- Anthropic -------------------------------------------------------------
ANTHROPIC_API_KEY=
# Modelo para etiquetar y para interpretar la peticion.
# claude-opus-5 es el mas preciso; claude-haiku-4-5 abarata el etiquetado masivo.
ANTHROPIC_MODEL=claude-opus-5

# --- App -------------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8000
DB_PATH=data/library.db
